{
  "id": "emote-pack-default",
  "name": "表情包插件",
  "version": "1.2.0",
  "description": "预置 24 张 512×512 表情与 4 个动图；支持列清单、按名称展示（可内联 data URI）、按词语确定性匹配，以及按语境推荐表情（本地小模型）",
  "protocol": "gqy-jsonrpc-v1",
  "command": [
    "node",
    "index.js"
  ],
  "cwd": ".",
  "timeout_ms": 10000,
  "concurrency": "concurrent",
  "actions": [
    {
      "name": "list",
      "description": "列出全部表情与动图：名称、标签、文件、字节数、尺寸；动图另含帧数与时长；另含语境模型元信息",
      "schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "show",
      "description": "按名称展示一张表情或动图；也接受清单内的文件路径；inline=true 时同时返回 data URI",
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "表情或动图名称，如 05-困倦；也接受清单内的文件路径"
          },
          "inline": {
            "type": "boolean",
            "description": "是否内联返回 data URI"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "match",
      "description": "按词语确定性打分匹配表情（名称完全相等、标签相等、包含关系），返回分数降序的候选",
      "schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "查询词，如 累"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24,
            "default": 3,
            "description": "返回条数上限，默认 3"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "suggest",
      "description": "按对话语境推荐一张表情：本地小模型推理，返回决策、none 分数与分数降序的候选；不适合发表情时 decision=none",
      "schema": {
        "type": "object",
        "properties": {
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "对话语境（最近 1–3 轮），1–2000 字符"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3,
            "description": "返回条数上限，默认 3"
          }
        },
        "required": [
          "context"
        ]
      }
    }
  ],
  "provides": [],
  "requires": [],
  "settings": [
    {
      "key": "auto_emote",
      "title": "回复后自动发表情",
      "type": "boolean",
      "default": true,
      "description": "开启后，每次模型回复完成时由本插件的小模型判断是否发一张表情"
    },
    {
      "key": "min_score",
      "title": "最低置信度",
      "type": "number",
      "default": 0.5,
      "description": "top1 表情的置信度达到该值才自动发（0–1）"
    }
  ]
}
